# Copy this file to `claude-auth.env` (gitignored) and paste the token.
#
# How to get the token:
#   1. On the host run:  claude setup-token
#   2. It opens a browser, you authorize with your Claude subscription,
#      then the CLI prints a long-lived OAuth token.
#   3. Paste it on the right-hand side below.
#
# This token authenticates the `claude` CLI inside the container, so the
# subscription-based agent works without ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=

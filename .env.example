# LLM auth is handled by the `claude` CLI (Claude Code subscription).
# Run `claude --version` to verify CLI installation, then `claude` to log in.
# No ANTHROPIC_API_KEY is required.
#
# Optional override — set this only if you want to use a direct API key
# instead of subscription auth (e.g. in CI):
# ANTHROPIC_API_KEY=

# Default model for compliance agents.
PHARMA_AD_MODEL=claude-sonnet-4-6

# --------------------------------------------------------------------------
# DANGER — disables the SSRF guard. NEVER set in production.
# Allows fetching URLs that resolve to private/loopback IPs. Only for local
# integration tests against a dev server on 127.0.0.1.
# --------------------------------------------------------------------------
# PHARMA_AD_ALLOW_PRIVATE_URLS=1

# Optional resource caps (defaults shown):
# PHARMA_AD_MAX_FILE_BYTES=20971520        # 20 MiB
# PHARMA_AD_PDF_MAX_PAGES=30
# PHARMA_AD_PDF_MAX_OCR_PAGES=15
# PHARMA_AD_URL_MAX_BYTES=5242880          # 5 MiB
# PHARMA_AD_LLM_TIMEOUT=120                # seconds per LLM call
# PHARMA_AD_MAX_CONCURRENCY=6              # in-flight LLM calls
# PHARMA_AD_THINKING=0                     # extended thinking off by default
# PHARMA_AD_TIMING=0                       # per-stage/per-call timing logs
